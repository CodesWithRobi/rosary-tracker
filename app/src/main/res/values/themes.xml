<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Force Light theme — no DayNight -->
    <style name="Theme.RosaryTracker" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/deep_blue</item>
        <item name="colorPrimaryVariant">@color/deep_blue_variant</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/gold</item>
        <item name="colorSecondaryVariant">@color/gold_variant</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar — transparent for edge-to-edge on API 21+ -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <!-- Navigation bar — fully transparent, no scrim -->
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- Window background — warm off-white -->
        <item name="android:windowBackground">@color/background_light</item>
        <!-- Text colors for light theme -->
        <item name="android:textColorPrimary">@color/deep_blue</item>
        <item name="android:textColorSecondary">@color/grey_dark</item>
        <item name="android:textColorHint">@color/grey</item>
    </style>
</resources>
